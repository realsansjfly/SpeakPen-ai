# Server-only credentials. Never copy into an APK or commit.
HOST=127.0.0.1
PORT=8787
PROVIDER_PRIORITY=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Custom Qwen-compatible gateways may use their own key format and base URL.
DASHSCOPE_CHAT_MODEL=qwen3.7-flash-2026-07-15
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# Optional independent official Alibaba Bailian key for natural cloud speech.
# Keep this server-only. When omitted, official DashScope chat credentials may be reused;
# custom compatible gateway credentials are never forwarded to Alibaba.
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Cherry
# Generated by scripts/start-service.ps1; separate from the Alibaba provider key.
SERVICE_ACCESS_TOKEN=
# Enable on a public cloud host; startup fails if the service token is missing/invalid.
REQUIRE_AUTH=false
MAX_REQUESTS_PER_MINUTE=30
MAX_DAILY_REQUESTS=500
# Quick tunnels do not support SSE. Android falls back to JSON responses.
DISABLE_STREAMING=true
# Optional alternatives:
GROQ_API_KEY=
SILICONFLOW_API_KEY=
